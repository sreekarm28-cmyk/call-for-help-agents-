TEST_CALLS_ENABLED=false
TEST_PHONE_NUMBER=
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=replace_with_your_google_places_api_key
# Optional Geocoding key. With this blank, address lookup uses the Places key.
GOOGLE_GEOCODING_API_KEY=
SESSION_SECRET=replace_with_a_long_random_value_before_deployment
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_BASE_URL=https://cloud.langfuse.com
