{
  "name": "call-for-help-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui,worker -c magenta,cyan,yellow \"npm:dev:server\" \"npm:dev:client\" \"npm:scheduler:product\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:mcp": "tsx server/mcp/google-places-client.ts --live",
    "test:provider-flow": "node --import tsx tests/provider-flow.ts",
    "scheduler:worker": "tsx server/scheduler/worker.ts",
    "scheduler:product": "npm run scheduler:worker",
    "db:migrate": "dotenv -e .env -- node-pg-migrate up --migrations-dir database/migrations",
    "db:rollback": "dotenv -e .env -- node-pg-migrate down --migrations-dir database/migrations",
    "test:auth": "node --import tsx tests/provider-flow.ts auth",
    "test:request": "node --import tsx tests/provider-flow.ts request",
    "test:provider-search": "node --import tsx tests/provider-flow.ts provider-search",
    "test:booking": "node --import tsx tests/provider-flow.ts booking",
    "test:replacement": "node --import tsx tests/provider-flow.ts replacement",
    "test:booking-visibility": "node --import tsx tests/provider-flow.ts booking-visibility",
    "test:llm-extraction": "node --import tsx tests/provider-flow.ts llm-extraction",
    "test:call-limit": "node --import tsx tests/provider-flow.ts call-limit",
    "test:confirmation": "node --import tsx tests/provider-flow.ts confirmation",
    "test:provider-recall": "node --import tsx tests/provider-flow.ts provider-recall",
    "test:provider-preferences": "node --import tsx tests/provider-flow.ts provider-preferences",
    "evals": "tsx server/evaluation/server.ts",
    "test:evaluations": "node --import tsx --test tests/evaluation-flow.ts tests/evaluation-resume.ts tests/location-evaluation.ts tests/location-validation.ts"
  },
  "dependencies": {
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.1.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
